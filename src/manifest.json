{
  "manifest_version": 3,
  "name": "yt-dlp-button",
  "version": "1.0.0",
  "description": "The button that generates yt-dlp command.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "css": ["balloon/balloon.css", "sites/youtube/button/button.css"],
      "js": ["ytdlp-command.js", "balloon/balloon-template.js", "balloon/balloon.js", "sites/youtube/button/button-template.js", "sites/youtube/button/button.js", "sites/youtube/content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sites/youtube/button/*.svg", "balloon/copied.svg"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
