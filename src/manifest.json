{
  "manifest_version": 3,
  "name": "yt-yt-dlp",
  "version": "1.0.0",
  "description": "Adds a yt-dlp button next to Save on YouTube watch pages.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "css": ["youtube/balloon/balloon.css", "youtube/button/button.css"],
      "js": ["ytdlp-command.js", "youtube/balloon/balloon-template.js", "youtube/balloon/balloon.js", "youtube/button/button-template.js", "youtube/button/button.js", "youtube/content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["youtube/button/*.svg", "youtube/balloon/copied.svg"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
